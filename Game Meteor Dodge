import asyncio
import random
import pygame

async def main():

    # 1. INIT
    pygame.init()

    audio_aktif = True

    try:
        pygame.mixer.init()
    except pygame.error:
        audio_aktif = False

    # 2. LAYAR
    width, height = 600, 600

    window = pygame.display.set_mode((width, height))
    pygame.display.set_caption("Meteor Dodge")

    clock = pygame.time.Clock()

    # 3. FONT
    font_skor = pygame.font.SysFont("Arial", 30, bold=True)
    font_teks_skor = pygame.font.SysFont("Arial", 28)
    font_game_over = pygame.font.SysFont("Arial", 50, bold=True)
    font_info = pygame.font.SysFont("Arial", 22)

    font_judul_home = pygame.font.SysFont("Arial", 56, bold=True)
    font_tombol_home = pygame.font.SysFont("Arial", 30, bold=True)

    # 4. MEMUAT GAMBAR
    asset_error = []

    def load_image(nama_file, ukuran_cadangan, alpha=True):
        try:
            gambar = pygame.image.load(nama_file)

            if alpha:
                gambar = gambar.convert_alpha()
            else:
                gambar = gambar.convert()

            return gambar

        except Exception:
            asset_error.append(nama_file)

            flags = pygame.SRCALPHA if alpha else 0
            gambar = pygame.Surface(ukuran_cadangan, flags)
            gambar.fill((100, 50, 100))

            return gambar

    rocket = load_image("rocket.png", (64, 64))
    asteroid = load_image("asteroid.png", (32, 32))
    explode = load_image("explode.png", (64, 64))
    background = load_image(
        "background.jpg", (width, height), alpha=False
    )

    background = pygame.transform.scale(
        background, (width, height)
    )

    tinggi_rocket = rocket.get_height()
    lebar_rocket = rocket.get_width()

    tinggi_asteroid = asteroid.get_height()
    lebar_asteroid = asteroid.get_width()

    # Ikon aplikasi tetap menggunakan gambar rocket.
    try:
        pygame.display.set_icon(rocket)
    except pygame.error:
        pass

    # 5. AUDIO
    def load_sound(nama_file):
        if not audio_aktif:
            return None

        try:
            return pygame.mixer.Sound(nama_file)
        except (pygame.error, FileNotFoundError):
            return None

    sfx_game_over = load_sound("game over sound.ogg")
    sfx_collision = load_sound("collision.ogg")

    musik_tersedia = False

    if audio_aktif:
        try:
            pygame.mixer.music.load("background sound.ogg")
            musik_tersedia = True
        except (pygame.error, FileNotFoundError):
            musik_tersedia = False

    def mulai_musik():
        if audio_aktif and musik_tersedia:
            try:
                pygame.mixer.music.play(-1)
            except pygame.error:
                pass

    def hentikan_musik():
        if audio_aktif:
            try:
                pygame.mixer.music.stop()
            except pygame.error:
                pass

    # 6. TOMBOL HOME
    tombol_mulai = pygame.Rect(
        width // 2 - 120,
        340,
        240,
        70
    )

    home_overlay = pygame.Surface(
        (width, height), pygame.SRCALPHA
    )
    home_overlay.fill((0, 0, 0, 135))

    # 7. VARIABEL PEMAIN DAN HP
    x_rocket, y_rocket = 270, 500

    MAX_HP = 75
    hp = MAX_HP

    # 8. EFEK LEDAKAN
    exploding = False
    waktu_explosion = 0
    DURASI_EXPLOSION = 500

    # 9. INVINCIBILITY / EFEK KEBAL
    invincible = False
    waktu_mulai_kebal = 0
    DURASI_KEBAL = 2000

    # 10. ANIMASI KEMATIAN
    mati = False
    waktu_mulai_mati = 0
    DURASI_ANIMASI_MATI = 2000

    # 11. METEOR
    JUMLAH_METEOR = 8
    daftar_meteor = []

    def buat_meteor():
        x_acak = random.randint(
            0, width - lebar_asteroid
        )
        y_acak = random.randint(-500, -32)
        kecepatan = random.randint(3, 6)

        hitbox_meteor = pygame.Rect(
            x_acak,
            y_acak,
            lebar_asteroid,
            tinggi_asteroid
        )

        return {
            "rect": hitbox_meteor,
            "speed": kecepatan
        }

    for _ in range(JUMLAH_METEOR):
        daftar_meteor.append(buat_meteor())

    # 12. VARIABEL GAME
    skor = 0
    running = True

    # Home -> playing -> game_over
    game_state = "home"

    # 13. FUNGSI RESET GAME
    def reset_game():
        nonlocal x_rocket, y_rocket, skor, hp
        nonlocal game_state
        nonlocal invincible, waktu_mulai_kebal
        nonlocal exploding, waktu_explosion
        nonlocal mati, waktu_mulai_mati

        x_rocket, y_rocket = 270, 500

        skor = 0
        hp = MAX_HP

        invincible = False
        waktu_mulai_kebal = 0

        exploding = False
        waktu_explosion = 0

        mati = False
        waktu_mulai_mati = 0

        # Reset posisi dan kecepatan semua meteor
        for m in daftar_meteor:
            m["rect"].x = random.randint(
                0, width - lebar_asteroid
            )
            m["rect"].y = random.randint(-500, -32)
            m["speed"] = random.randint(3, 6)

        game_state = "playing"

        # Musik mulai sesudah tombol MULAI diklik
        mulai_musik()

    # 14. FUNGSI TEKS DI TENGAH LAYAR
    def tampilkan_teks_tengah(
        teks, font, warna, posisi_x, posisi_y
    ):
        gambar_teks = font.render(teks, True, warna)

        posisi_teks = gambar_teks.get_rect(
            center=(posisi_x, posisi_y)
        )

        window.blit(gambar_teks, posisi_teks)

    # 15. LOOP UTAMA ASYNC
    while running:

        waktu_sekarang = pygame.time.get_ticks()

        # EVENT / INPUT PEMAIN
        for event in pygame.event.get():

            if event.type == pygame.QUIT:
                running = False

            # Klik tombol MULAI
            if (
                event.type == pygame.MOUSEBUTTONDOWN
                and event.button == 1
                and game_state == "home"
            ):
                if tombol_mulai.collidepoint(event.pos):
                    reset_game()

            # Tekan R untuk bermain kembali
            if event.type == pygame.KEYDOWN:

                if (
                    game_state == "game_over"
                    and event.key == pygame.K_r
                ):
                    reset_game()

        # JIKA ADA GAMBAR YANG TIDAK DITEMUKAN
        if asset_error:

            window.fill((15, 20, 35))

            tampilkan_teks_tengah(
                "GAMBAR TIDAK DITEMUKAN",
                font_teks_skor,
                (255, 100, 100),
                width // 2,
                150
            )

            for i, nama_file in enumerate(asset_error):
                tampilkan_teks_tengah(
                    nama_file,
                    font_info,
                    (255, 255, 255),
                    width // 2,
                    220 + i * 35
                )

            pygame.display.flip()
            clock.tick(60)

            # Wajib memberi waktu kepada browser.
            await asyncio.sleep(0)
            continue

        # UPDATE GAMEPLAY
        if game_state == "playing":

            # Akhiri efek kebal setelah 2 detik
            if invincible:
                if (
                    waktu_sekarang - waktu_mulai_kebal
                    >= DURASI_KEBAL
                ):
                    invincible = False

            # Akhiri ledakan biasa
            if exploding:
                if (
                    waktu_sekarang - waktu_explosion
                    >= DURASI_EXPLOSION
                ):
                    exploding = False

            # Akhiri animasi kematian
            if mati:
                if (
                    waktu_sekarang - waktu_mulai_mati
                    >= DURASI_ANIMASI_MATI
                ):
                    mati = False
                    game_state = "game_over"

                    hentikan_musik()

                    if sfx_game_over is not None:
                        sfx_game_over.play()

            # GERAKAN ROCKET
            if game_state == "playing" and not mati:

                kunci = pygame.key.get_pressed()

                if (
                    kunci[pygame.K_LEFT]
                    or kunci[pygame.K_a]
                ):
                    x_rocket -= 10

                if (
                    kunci[pygame.K_RIGHT]
                    or kunci[pygame.K_d]
                ):
                    x_rocket += 10

                if (
                    kunci[pygame.K_UP]
                    or kunci[pygame.K_w]
                ):
                    y_rocket -= 10

                if (
                    kunci[pygame.K_DOWN]
                    or kunci[pygame.K_s]
                ):
                    y_rocket += 10

                # Batasi gerakan agar rocket tidak keluar layar
                x_rocket = max(
                    0,
                    min(x_rocket, width - lebar_rocket)
                )

                y_rocket = max(
                    0,
                    min(y_rocket, height - tinggi_rocket)
                )

                # Hitbox rocket
                hitbox_rocket = pygame.Rect(
                    x_rocket,
                    y_rocket,
                    lebar_rocket,
                    tinggi_rocket
                )


                # GERAKAN METEOR DAN TABRAKAN

                for m in daftar_meteor:

                    m["rect"].y += m["speed"]

                    # Meteor lolos ke bawah layar
                    if m["rect"].top >= height:

                        m["rect"].x = random.randint(
                            0, width - lebar_asteroid
                        )

                        m["rect"].y = random.randint(-150, -32)

                        skor += 1

                    # Deteksi tabrakan
                    if (
                        not invincible
                        and hitbox_rocket.colliderect(
                            m["rect"]
                        )
                    ):

                        hp -= 25

                        # Aktifkan kebal
                        invincible = True
                        waktu_mulai_kebal = (
                            pygame.time.get_ticks()
                        )

                        # Aktifkan ledakan
                        exploding = True
                        waktu_explosion = (
                            pygame.time.get_ticks()
                        )

                        if sfx_collision is not None:
                            sfx_collision.play()

                        # Pindahkan meteor yang menabrak
                        m["rect"].x = random.randint(
                            0, width - lebar_asteroid
                        )

                        m["rect"].y = random.randint(
                            -150, -32
                        )

                        # HP habis
                        if hp <= 0:

                            hp = 0
                            mati = True

                            waktu_mulai_mati = (
                                pygame.time.get_ticks()
                            )

                            hentikan_musik()

        # GAMBAR HALAMAN HOME
        if game_state == "home":

            window.blit(background, (0, 0))
            window.blit(home_overlay, (0, 0))

            # Bayangan judul
            tampilkan_teks_tengah(
                "METEOR DODGE",
                font_judul_home,
                (0, 0, 0),
                width // 2 + 3,
                224
            )

            # Judul utama
            tampilkan_teks_tengah(
                "METEOR DODGE",
                font_judul_home,
                (225, 250, 255),
                width // 2,
                220
            )

            # Garis aksen
            pygame.draw.rect(
                window,
                (255, 195, 65),
                (width // 2 - 55, 270, 110, 5),
                border_radius=3
            )

            # Tombol berubah warna saat disentuh mouse
            posisi_mouse = pygame.mouse.get_pos()

            if tombol_mulai.collidepoint(posisi_mouse):
                warna_tombol = (40, 205, 135)
            else:
                warna_tombol = (20, 145, 100)

            # Bayangan tombol
            pygame.draw.rect(
                window,
                (0, 0, 0),
                tombol_mulai.move(0, 6),
                border_radius=16
            )

            # Tombol MULAI
            pygame.draw.rect(
                window,
                warna_tombol,
                tombol_mulai,
                border_radius=16
            )

            pygame.draw.rect(
                window,
                (230, 255, 245),
                tombol_mulai,
                width=2,
                border_radius=16
            )

            tampilkan_teks_tengah(
                "MULAI",
                font_tombol_home,
                (255, 255, 255),
                tombol_mulai.centerx,
                tombol_mulai.centery
            )

        # GAMBAR GAMEPLAY
        elif game_state == "playing":

            window.blit(background, (0, 0))

            # Gambar seluruh meteor
            for m in daftar_meteor:
                window.blit(asteroid, m["rect"])

            # Gambar rocket atau ledakan
            if mati:

                window.blit(explode, (x_rocket, y_rocket))

            elif exploding:

                window.blit(explode, (x_rocket, y_rocket))

            elif invincible:

                # Rocket berkedip setiap 100 milidetik
                if (waktu_sekarang // 100) % 2 == 0:
                    window.blit(
                        rocket, (x_rocket, y_rocket)
                    )

            else:

                window.blit(rocket, (x_rocket, y_rocket))

            # HEALTH BAR
            bar_x, bar_y = 15, 15
            bar_lebar, bar_tinggi = 150, 20

            # Dasar merah
            pygame.draw.rect(
                window,
                (200, 0, 0),
                (bar_x, bar_y, bar_lebar, bar_tinggi)
            )

            # Bar hijau sesuai HP
            rasio_hp = max(0, min(hp / MAX_HP, 1))

            pygame.draw.rect(
                window,
                (0, 220, 0),
                (
                    bar_x,
                    bar_y,
                    int(bar_lebar * rasio_hp),
                    bar_tinggi
                )
            )

            # Garis tepi putih
            pygame.draw.rect(
                window,
                (255, 255, 255),
                (bar_x, bar_y, bar_lebar, bar_tinggi),
                2
            )

            # SKOR
            teks_skor = font_skor.render(
                str(skor),
                True,
                (255, 255, 255)
            )

            window.blit(teks_skor, (270, 10))

        # LAYAR GAME OVER
        elif game_state == "game_over":

            window.fill((0, 0, 0))

            tampilkan_teks_tengah(
                "GAME OVER!",
                font_game_over,
                (255, 50, 50),
                width // 2,
                240
            )

            tampilkan_teks_tengah(
                f"Last Score: {skor}",
                font_teks_skor,
                (255, 255, 255),
                width // 2,
                310
            )

            tampilkan_teks_tengah(
                "Press 'R' for Play again!",
                font_info,
                (200, 200, 200),
                width // 2,
                365
            )

        # UPDATE LAYAR DAN SERAHKAN KENDALI
        pygame.display.flip()
        clock.tick(60)

        # Wajib ada pada setiap putaran loop untuk Pygbag.
        await asyncio.sleep(0)

    # KELUAR
    pygame.quit()

if __name__ == "__main__":
    asyncio.run(main())
