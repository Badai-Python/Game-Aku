# Variabel Tembakan Musuh
cd_musuh = 0
durasi_cooldown_musuh = 500
daftar_peluru_musuh = []
kecepatan_peluru_musuh = 5

# Variabel Tembakan
cd = 0
durasi_cooldown = 100  
daftar_peluru = []
