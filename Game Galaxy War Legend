# 4. variabel
clock = pygame.time.Clock()
font = pygame.font.Font(None,30)
font.set_bold(True)
font.set_italic(True)

hp = 10
x_spaceship = 170
y_spaceship = 500

# Variabel Boss Alien
x_alien = random.randint(0,300)
y_alien = -200  
velocity_y_alien = 3
velocity_x_alien = 2
boss_aktif = False
hp_boss = 5

x_plasma_alien = x_alien + 50
y_plasma_alien = y_alien + 65

x_plasma_alien_2 = x_alien + 30
y_plasma_alien_2 = y_alien + 65

# Variabel Meteor
x_enemy = random.randint(0,300)
y_enemy = random.randint(0,0)
